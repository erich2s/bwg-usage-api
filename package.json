    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}